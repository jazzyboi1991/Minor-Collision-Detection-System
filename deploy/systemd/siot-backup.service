[Unit]
Description=SIOT encrypted database and video backup
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=__USER__
WorkingDirectory=__REPO__/backend
EnvironmentFile=__REPO__/.env
EnvironmentFile=/home/__USER__/.config/siot-backup/backup.env
ExecStart=__REPO__/venv311/bin/python -m app.backup_runner
UMask=0077
TimeoutStartSec=12h
